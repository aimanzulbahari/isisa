# ==========================================
# ISISA - Environment Configuration Example
# Copy this file to ".env" and fill in your real values.
# Never put real passwords in this example file.
# ==========================================

# --- Application ---
# APP_ENV         : local | staging | production
# APP_DEBUG       : must be false in production
# APP_LOCALE      : MY (Bahasa Melayu) | EN (English)
# APP_MAINTENANCE : true = show the 503 maintenance page
APP_NAME="ISISA"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/isisa
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_LOCALE=MY
APP_MAINTENANCE=false

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=isisa_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Session ---
# SESSION_LIFETIME     : maximum session age, in minutes
# SESSION_IDLE_TIMEOUT : auto logout after this many idle minutes
# SESSION_SECURE_COOKIE: set to true when using HTTPS
# SESSION_SAMESITE     : Lax | Strict | None
SESSION_NAME=isisa_session
SESSION_LIFETIME=120
SESSION_IDLE_TIMEOUT=30
SESSION_SECURE_COOKIE=false
SESSION_SAMESITE=Lax

# --- Security ---
# CSRF_TOKEN_LIFETIME  : in minutes
# CORS_ALLOWED_ORIGINS : comma-separated list. Leave empty to allow same-origin only.
# LOGIN_MAX_ATTEMPTS   : wrong passwords allowed before the account is locked
# LOGIN_LOCKOUT_MINUTES: how long the account stays locked
CSRF_TOKEN_LIFETIME=120
CORS_ALLOWED_ORIGINS=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Email (SMTP, used by PHPMailer) ---
# MAIL_ENCRYPTION: tls | ssl | (empty for none)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="ISISA"

# --- Storage & Logging ---
# UPLOAD_MAX_SIZE_MB: maximum upload size, in megabytes
# LOG_LEVEL         : debug | info | warning | error
UPLOAD_MAX_SIZE_MB=10
LOG_LEVEL=debug
